    "for bar in bars3:\n",
    "    axes[2].text(\n",
    "        bar.get_width() + 0.5,\n",
    "        bar.get_y() + bar.get_height() / 2,\n",
    "        f\"{bar.get_width():.1f}%\",\n",
    "        va=\"center\"\n",
    "    )\n",
    "\n",
    "\n",
    "# -------------------------\n",
    "# Make scales consistent\n",
